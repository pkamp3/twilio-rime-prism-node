RIME_API_KEY=your-rime-api-key
PORT=5050

# Set this if your tunnel rewrites the Host header, as VS Code port forwarding does.
# PUBLIC_HOST=abcd1234-5050.use.devtunnels.ms

# Optional (Step 8): score and remember calls with Twilio Conversations. Leave these unset to skip it.
# Conversation Configuration ID, from Conversation Orchestrator in the Console.
# CONVERSATION_CONFIGURATION_ID=conv_configuration_...
# Memory Store ID, from Conversation Memory in the Console.
# MEMORY_STORE_ID=mem_store_...
# A Twilio API key and secret, for looking up callers in Memory.
# TWILIO_API_KEY=SK...
# TWILIO_API_SECRET=your-api-key-secret
